<launch>
  <!--
    3V3 仿真总入口（mowen2 万向轮版）
    启动流程：
      1. 仿真环境（6台机器人：3红+3蓝）
      2. 裁判系统 (referee)
      3. 两队 Manager (red_manager + blue_manager)
      4. 六辆小车 agent (car_node)

    使用方法：
      roslaunch robot_vs simulation/3v3vs_simulation.launch
  -->

  <!-- 1. 启动 6 台机器人仿真环境 -->
  <include file="$(find robot_vs)/launch/simulation/multi_robot6_turtlebot.launch" />

  <!-- 2. 启动裁判系统 -->
  <include file="$(find robot_vs)/launch/manager/referee.launch" />

  <!-- 3. 启动红蓝 Manager -->
  <include file="$(find robot_vs)/launch/manager/managers.launch" />

  <!-- 4. 启动 6 台小车 agent -->
  <include file="$(find robot_vs)/launch/simulation/cars6_simulation.launch" />

</launch>
